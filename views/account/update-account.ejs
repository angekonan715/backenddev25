<div class="container">
    <h1>Update Account Information</h1>

    <% if (locals.message) { %>
        <div class="alert alert-success">
            <%= message %>
        </div>
        <% } %>

            <% if (locals.error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <% } %>

                    <% if (locals.errors && errors.length> 0) { %>
                        <div class="alert alert-danger">
                            <ul>
                                <% errors.forEach(function(error) { %>
                                    <li>
                                        <%= error.msg %>
                                    </li>
                                    <% }); %>
                            </ul>
                        </div>
                        <% } %>

                            <!-- Account Update Form -->
                            <form id="accountUpdateForm" action="/account/update" method="post">
                                <fieldset>
                                    <legend>Account Update</legend>

                                    <div class="form-group">
                                        <label for="account_firstname">First Name:</label>
                                        <input type="text" name="account_firstname" id="account_firstname"
                                            value="<%= locals.account_firstname || '' %>" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="account_lastname">Last Name:</label>
                                        <input type="text" name="account_lastname" id="account_lastname"
                                            value="<%= locals.account_lastname || '' %>" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="account_email">Email:</label>
                                        <input type="email" name="account_email" id="account_email"
                                            value="<%= locals.account_email || '' %>" required>
                                    </div>

                                    <!-- Student Status Section -->
                                    <div class="form-group student-section">
                                        <div class="student-header">
                                            <h4>🎓 Student Discount Status</h4>
                                            <p>Save 15% on vehicles over $1,000 with a valid .edu email!</p>
                                        </div>
                                        
                                        <div class="form-group">
                                            <label>
                                                <input type="checkbox" name="is_student" id="is_student" value="true" 
                                                       <%= (locals.is_student || locals.accountData?.is_student) ? 'checked' : '' %>>
                                                I am a student and want to apply for student discounts
                                            </label>
                                        </div>

                                        <div class="form-group" id="student_email_group" style="<%= (locals.is_student || locals.accountData?.is_student) ? '' : 'display: none;' %>">
                                            <label for="student_email">Student Email (.edu required):</label>
                                            <input type="email" name="student_email" id="student_email" 
                                                   value="<%= locals.student_email || locals.accountData?.student_email || '' %>"
                                                   placeholder="your.name@university.edu">
                                            <small>Please provide your .edu email address for verification</small>
                                            <% if (locals.accountData?.student_verification_date) { %>
                                                <small class="verification-date">Last verified: <%= new Date(locals.accountData.student_verification_date).toLocaleDateString() %></small>
                                            <% } %>
                                        </div>
                                    </div>

                                    <input type="hidden" name="account_id" value="<%= locals.account_id %>">

                                    <div class="form-group">
                                        <input type="submit" value="Update Account" class="btn btn-primary">
                                        <a href="/account/" class="btn btn-secondary">Cancel</a>
                                    </div>
                                </fieldset>
                            </form>

                            <!-- Change Password Form -->
                            <form id="passwordChangeForm" action="/account/change-password" method="post">
                                <fieldset>
                                    <legend>Change Password</legend>

                                    <div class="form-group">
                                        <label for="account_password">New Password:</label>
                                        <input type="password" name="account_password" id="account_password" required>
                                        <small>Password must be at least 10 characters and contain at least 1 uppercase
                                            character, 1 lowercase character, 1 number, and 1 special character.</small>
                                    </div>

                                    <input type="hidden" name="account_id" value="<%= locals.account_id %>">

                                    <div class="form-group">
                                        <input type="submit" value="Change Password" class="btn btn-primary">
                                        <a href="/account/" class="btn btn-secondary">Cancel</a>
                                    </div>
                                </fieldset>
                            </form>
</div>

<link rel="stylesheet" href="/css/student-discount.css">
<script src="/js/student-discount.js"></script>